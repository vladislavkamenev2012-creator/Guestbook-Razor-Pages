@page
@model LoginModel

@{
    ViewData["Title"] = "Аутентификация";
}

<h2>Вход в систему</h2>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Input.Login"></label>
        <input asp-for="Input.Login" class="form-control" />
        <span asp-validation-for="Input.Login" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-success">Войти</button>
    <a asp-page="./Register" class="btn btn-primary">Регистрация</a>
    <a asp-page="./GuestLogin" class="btn btn-info">Войти как гость</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('form input').on('input', function () {
                $(this).valid();
            });
        });
    </script>
}
